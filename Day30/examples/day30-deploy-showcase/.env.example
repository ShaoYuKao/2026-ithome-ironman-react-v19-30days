# .env
# 所有模式（development／production）都會套用的預設值。
#
# 只有 VITE_ 開頭的變數才會被 Vite 打包進前端程式碼、能用
# import.meta.env.VITE_XXX 讀取；沒有 VITE_ 前綴的變數，只有
# vite.config.js 這類建置腳本本身讀得到，不會外流到瀏覽器（詳見
# README 第三節）。也因為前端 bundle 是完全公開的，這裡絕對不能放
# API 金鑰、密碼這類機密資料。

VITE_APP_TITLE=React 30 天學習筆記

# 部署前請換成你自己的 GitHub 帳號與 repo 名稱，
# 「在 GitHub 上閱讀完整教學文件」連結才會指向正確位置。
VITE_GITHUB_REPO_URL=https://github.com/<your-github-account>/React_30Day_Note

# GitHub Pages 專案頁需要的路徑前綴，格式是 /repo名稱/（記得前後都要有斜線）；
# 部署到 Vercel／Netlify，或 GitHub Pages 使用者頁（帳號.github.io）時，維持 /。
VITE_BASE_PATH=/
